generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  DISPATCHER
  VIEWER
}

model Organization {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  weekStartsOn   Int             @default(1)
  timezone       String          @default("America/Chicago")
  settings       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  memberships    Membership[]
  files          DataFile[]
  runs           ImportRun[]
  mappings       ColumnMapping[]
  placeAliases   PlaceAlias[]
  shares         AnswerShare[]
  corrections    Correction[]
  standingRules  StandingRule[]
  briefs         Brief[]
  subscription   Subscription?
  meterEvents    MeterEvent[]
  accessLogs     AccessLog[]
  pilotChecklist PilotChecklist?
  notifications  Notification[]
  ontoTypes    OntoType[]
  ontoLinks    OntoLink[]
  ontoVersions OntoTypeVersion[]
  ontoObjects  OntoObject[]
  ontoEdges    OntoEdge[]
  ontoAliases  OntoAlias[]
  ontoFacts    OntoFact[]
  ontoEvents   OntoEvent[]
  ontoActions  OntoAction[]
  ontoApprovals OntoApproval[]
  ontoActionRuns OntoActionRun[]
  ontoPolicies OntoPolicy[]
  ontoBranches OntoBranch[]
  ontoWebhooks OntoWebhook[]
}

model OntoBranch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  baseVersions   Json
  changes        Json
  status         String   @default("open")
  createdById    String   @default("")
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model OntoType {
  id             String            @id @default(cuid())
  organizationId String
  key            String
  label          String
  plural         String            @default("")
  description    String            @default("")
  version        Int               @default(1)
  status         String            @default("active")
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties     OntoProperty[]
  versions       OntoTypeVersion[]

  @@unique([organizationId, key])
  @@index([organizationId, status])
}

model OntoProperty {
  id             String   @id @default(cuid())
  organizationId String
  typeId         String
  key            String
  label          String   @default("")
  kind           String
  required       Boolean  @default(false)
  unique         Boolean  @default(false)
  indexed        Boolean  @default(false)
  immutable      Boolean  @default(false)
  config         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  type           OntoType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@unique([typeId, key])
  @@index([organizationId])
}

model OntoLink {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  fromTypeKey    String
  toTypeKey      String
  cardinality    String
  inverseKey     String?
  required       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
}

model OntoTypeVersion {
  id             String   @id @default(cuid())
  organizationId String
  typeId         String
  version        Int
  snapshot       Json
  note           String   @default("")
  createdById    String   @default("")
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           OntoType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@unique([typeId, version])
  @@index([organizationId])
}

model OntoObject {
  id             String   @id @default(cuid())
  organizationId String
  typeKey        String
  key            String
  data           Json
  version        Int      @default(1)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, typeKey, key])
  @@index([organizationId, typeKey])
}

model OntoEdge {
  id             String   @id @default(cuid())
  organizationId String
  fromId         String
  linkKey        String
  toId           String
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([fromId, linkKey, toId])
  @@index([organizationId, fromId])
  @@index([organizationId, toId])
  @@index([organizationId, linkKey])
}

model OntoAlias {
  id             String   @id @default(cuid())
  organizationId String
  objectId       String
  alias          String
  source         String   @default("manual")
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, alias])
  @@index([organizationId, objectId])
}

model OntoFact {
  id             String    @id @default(cuid())
  organizationId String
  objectId       String
  property       String
  value          Json
  validFrom      DateTime
  validTo        DateTime?
  txnAt          DateTime  @default(now())
  sourceRunId    String?
  reason         String    @default("")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, objectId, property, validFrom])
  @@index([organizationId, objectId, txnAt])
}

model OntoEvent {
  id             String   @id @default(cuid())
  organizationId String
  kind           String
  objectId       String   @default("")
  actorId        String   @default("")
  before         Json?
  after          Json?
  prevHash       String   @default("")
  hash           String   @default("")
  legalHold      Boolean  @default(false)
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, objectId, createdAt])
  @@index([organizationId, kind, createdAt])
}

model OntoAction {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  label          String
  targetTypeKey  String
  inputs         Json
  effects        Json
  approvalPolicy String   @default("none")
  requiredCount  Int      @default(1)
  enabled        Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
}

model OntoApproval {
  id             String    @id @default(cuid())
  organizationId String
  actionKey      String
  objectId       String
  inputs         Json?
  requestedById  String
  status         String    @default("pending")
  approvals      Json?
  requiredCount  Int       @default(1)
  expiresAt      DateTime?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, objectId])
}

model OntoWebhook {
  id             String   @id @default(cuid())
  organizationId String
  actionKey      String
  url            String
  secret         String   @default("")
  active         Boolean  @default(true)
  lastStatus     Int?
  lastAt         DateTime?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, actionKey])
  @@index([organizationId, active])
}

model OntoActionRun {
  id             String   @id @default(cuid())
  organizationId String
  idempotencyKey String
  actionKey      String
  objectId       String
  status         String   @default("ok")
  result         Json?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, actionKey])
}

model OntoPolicy {
  id             String   @id @default(cuid())
  organizationId String
  typeKey        String
  effect         String
  field          String   @default("")
  op             String   @default("eq")
  value          Json?
  priority       Int      @default(100)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, typeKey, active])
}

model AnswerShare {
  id             String       @id @default(cuid())
  organizationId String
  weekStart      String
  pack           String       @default("freight")
  token          String       @unique
  expiresAt      DateTime
  revoked        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Correction {
  id             String       @id @default(cuid())
  organizationId String
  targetType     String       @default("cost-line")
  targetKey      String
  field          String       @default("")
  oldValue       String       @default("")
  newValue       String       @default("")
  reason         String       @default("")
  status         String       @default("open")
  proposedById   String
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, targetKey])
  @@index([proposedById])
}

model StandingRule {
  id                 String       @id @default(cuid())
  organizationId     String
  kind               String       @default("reattribute")
  costKind           String       @default("")
  matchField         String       @default("")
  matchValue         String       @default("")
  toLoad             String?
  reason             String       @default("")
  authorId           String
  active             Boolean      @default(true)
  sourceCorrectionId String?
  createdAt          DateTime     @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, active])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  kind           String
  title          String
  href           String       @default("")
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@index([userId, readAt])
}

model Brief {
  id             String       @id @default(cuid())
  organizationId String
  weekStart      String
  pack           String       @default("freight")
  content        Json
  emailedTo      Json?
  feedback       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, weekStart, pack])
  @@index([organizationId])
}

model Subscription {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  tier             String       @default("free")
  status           String       @default("active")
  stripeCustomerId String?
  stripeSubId      String?
  currentPeriodEnd DateTime?
  statusChangedAt  DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model MeterEvent {
  id             String       @id @default(cuid())
  organizationId String
  kind           String
  pack           String       @default("freight")
  qty            Int          @default(1)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, createdAt])
}

model AccessLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  action         String
  target         String       @default("")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model PilotChecklist {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  firstAnswerAt      DateTime?
  firstCorrectionAt  DateTime?
  meetingConfirmedAt DateTime?
  meetingConfirmedBy String?
  convertedAt        DateTime?
  notes              String       @default("")
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model PlaceAlias {
  id             String       @id @default(cuid())
  organizationId String
  alias          String
  canonical      String
  createdById    String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, alias])
  @@index([organizationId])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role         @default(VIEWER)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  emailOptOut   Boolean      @default(false)
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

enum ImportStatus {
  PENDING
  PROCESSING
  NEEDS_REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

model DataFile {
  id             String       @id @default(cuid())
  organizationId String
  uploadedById   String
  filename       String
  bytes          Int
  mime           String
  checksum       String
  storageKey     String
  scannedOk      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs           ImportRun[]

  @@index([organizationId, checksum])
}

model ImportRun {
  id                String           @id @default(cuid())
  organizationId    String
  fileId            String
  uploadedById      String
  sourceType        String           @default("tms")
  status            ImportStatus     @default(PENDING)
  progress          Int              @default(0)
  totalRows         Int              @default(0)
  okRows            Int              @default(0)
  quarantinedRows   Int              @default(0)
  skippedRows       Int              @default(0)
  dateMin           DateTime?
  dateMax           DateTime?
  headers           Json?
  mapping           Json?
  mappingConfidence Json?
  duplicateOfRunId  String?
  decision          String?
  decisionNote      String?
  conflicts         Json?
  failureReason     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  file              DataFile         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  staged            StagedRecord[]
  rowErrors         ImportRowError[]

  @@index([organizationId, status])
}

model StagedRecord {
  id             String    @id @default(cuid())
  runId          String
  organizationId String
  rowNumber      Int
  loadKey        String?
  data           Json
  status         String    @default("ok")
  createdAt      DateTime  @default(now())
  run            ImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([organizationId, loadKey])
  @@index([organizationId, status])
}

model ImportRowError {
  id        String    @id @default(cuid())
  runId     String
  rowNumber Int
  raw       Json
  errors    Json
  createdAt DateTime  @default(now())
  run       ImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model ColumnMapping {
  id             String       @id @default(cuid())
  organizationId String
  sourceType     String
  fingerprint    String
  mapping        Json
  confidence     Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceType, fingerprint])
}

model EventLog {
  id        String   @id @default(cuid())
  type      String
  version   Int      @default(1)
  orgId     String
  pack      String   @default("freight")
  payload   Json
  status    String   @default("ok")
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([type, createdAt])
  @@index([status])
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  orgId     String
  url       String
  secret    String
  events    Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([orgId])
}

model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  keyHash    String    @unique
  prefix     String
  scopes     Json
  tier       String    @default("standard")
  revoked    Boolean   @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([orgId])
}

model AlertRule {
  id        String   @id @default(cuid())
  orgId     String
  pack      String   @default("freight")
  metric    String
  op        String
  threshold Float
  channel   String   @default("inapp")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  // EEMUA 191 rationalization: every rule documents who owns it, what the
  // required operator action is, and the response window in minutes. Rules
  // without these are FYI noise, not alarms.
  owner          String @default("")
  responseAction String @default("")
  windowMinutes  Int    @default(1440)

  @@index([orgId, active])
}

model WorkflowPlaybook {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  steps     Json
  schedule  String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  runs      WorkflowRun[]

  @@index([orgId])
}

model WorkflowRun {
  id         String           @id @default(cuid())
  playbookId String
  status     String           @default("ok")
  log        Json
  createdAt  DateTime         @default(now())
  playbook   WorkflowPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([playbookId, createdAt])
}

model OrgDeletion {
  id          String   @id @default(cuid())
  orgId       String   @unique
  requestedBy String
  purgeAt     DateTime
  createdAt   DateTime @default(now())

  @@index([purgeAt])
}
