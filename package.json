{
  "name": "monad",
  "version": "1.3.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "worker": "tsx scripts/worker.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "budget": "npx tsx scripts/bundle-budget.ts",
    "db:generate": "prisma generate",
    "db:generate:sqlite": "tsx scripts/generate-sqlite-schema.ts && prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:push": "prisma db push",
    "db:push:sqlite": "tsx scripts/generate-sqlite-schema.ts && prisma db push --schema=prisma/schema.sqlite.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "perf": "tsx scripts/perf.ts",
    "perf:shapes": "tsx scripts/bench-shapes.ts",
    "tenancy": "tsx scripts/tenancy-check.ts",
    "retention": "tsx scripts/retention-sweep.ts",
    "reconcile": "tsx scripts/reconcile-billing.ts",
    "e2e:stripe": "tsx stripe-e2e.ts",
    "release": "tsx scripts/release.ts",
    "electron:dev": "electron electron/main.cjs",
    "exe:prepare": "node electron/prepare.cjs",
    "dist:exe": "npm run build && npm run exe:prepare && electron-builder --win",
    "postinstall": "prisma generate"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "ai.monad.ontology",
    "productName": "Monad Ontology",
    "asar": false,
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Monad Ontology",
      "artifactName": "Monad-Ontology-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "packElevateHelper": false
    },
    "portable": {
      "artifactName": "Monad-Ontology-${version}.${ext}"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.58",
    "@ai-sdk/openai": "^4.0.71",
    "@auth/prisma-adapter": "^2.7.0",
    "@prisma/client": "^6.0.0",
    "ai": "^7.0.107",
    "bullmq": "^6.3.7",
    "cmdk": "^1.1.1",
    "csv-parse": "^5.6.0",
    "electron-updater": "^6.8.9",
    "force-graph": "^1.51.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.32",
    "posthog-js": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.13.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
