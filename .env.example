# Copy to .env and fill in. Zero real values here by policy (S-623, tested).
DATABASE_URL="postgresql://user:password@localhost:5432/decisionlayer"
AUTH_SECRET="generate-with-openssl-rand-base64-32-min-32-chars"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_RESEND_KEY=""
EMAIL_FROM="login@example.com"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_TEAM_PRICE_ID=""
# Optional: enables the annual (-20%) toggle on /pricing. Without it the
# toggle hides and checkout 501s honestly instead of charging wrong.
STRIPE_TEAM_ANNUAL_PRICE_ID=""
SENTRY_DSN=""
APP_URL="http://localhost:3000"
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
REDIS_URL=""
TRUSTED_PROXY=""
# Desktop auto-updates: the exe's update feed. Point at the deployed site —
# the feed file lives at <host>/api/updates. Empty means the updater stays
# dormant (portable copies and dev shells then update by redownloading).
UPDATE_FEED_URL=""
# Agent AI (NVIDIA NIM hosting DeepSeek) — default live model for all agent
# work. Key stays server-side only. Default model (set in code):
# deepseek-ai/deepseek-v4-flash-0731
NVIDIA_API_KEY=""
NVIDIA_MODEL=""
