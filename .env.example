# Copy to app/.env and fill in. Nothing here is secret — real values live in the host secret store.
# Phase 0 needs: DATABASE_URL, AUTH_SECRET. Everything else can wait for its phase.

# Postgres (docker-compose defaults match these)
# connection_limit=10&pool_timeout=20 recommended app-side (see docs/capacity.md)
DATABASE_URL="postgresql://decision:decision@localhost:5432/decisionlayer"

# Auth.js — generate with: npx auth secret (or: openssl rand -base64 32)
AUTH_SECRET="dev-only-secret-replace-me"
AUTH_URL="http://localhost:3000"

# Google OAuth (B-006) — from Google Cloud Console; leave blank until wired
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email magic links via Resend (B-006)
AUTH_RESEND_KEY=""
EMAIL_FROM="login@example.com"

# Product analytics (B-011) — leave blank to no-op
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Error tracking (B-010) — leave blank to log locally only
SENTRY_DSN=""

# Object storage (Phase 1: uploads)
S3_ENDPOINT=""
S3_BUCKET_UPLOADS=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Billing (Phase 7: Stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_TEAM_PRICE_ID=""
NEXT_PUBLIC_STRIPE_TEAM_PRICE_ID=""
